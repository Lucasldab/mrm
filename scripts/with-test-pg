#!/usr/bin/env bash
# Run a command against a throwaway Postgres cluster: initdb in a temp dir,
# unix socket only, trust auth, removed on exit. Exports MRM_TEST_DATABASE_URL.
# Needs the postgresql server binaries (Arch: postgresql; Debian: postgresql-17,
# with /usr/lib/postgresql/17/bin on PATH).
set -euo pipefail
command -v initdb >/dev/null || { echo "with-test-pg: initdb not found (install postgresql)" >&2; exit 2; }
dir=$(mktemp -d)
trap 'pg_ctl -D "$dir/data" -m immediate stop >/dev/null 2>&1 || true; rm -rf "$dir"' EXIT
initdb -D "$dir/data" -U mrm --auth=trust >/dev/null
pg_ctl -D "$dir/data" -o "-k $dir -c listen_addresses=''" -l "$dir/log" -w start >/dev/null
createdb -h "$dir" -U mrm mrm_test
export MRM_TEST_DATABASE_URL="postgres:///mrm_test?host=$dir&user=mrm"
"$@"
